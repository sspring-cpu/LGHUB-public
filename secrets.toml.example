# Copy this to .streamlit/secrets.toml (NOT committed to GitHub -- add
# .streamlit/secrets.toml to .gitignore) and fill in a real mailbox.
#
# On Streamlit Community Cloud, instead paste this same content into
# your app's Settings -> Secrets in the dashboard; you don't need the
# file there at all.
#
# Any SMTP-capable mailbox works. For Microsoft 365 you can usually use:
#   host = "smtp.office365.com"
#   port = 587
# with SMTP AUTH enabled on the mailbox and an app password if MFA is on.
# For Gmail / Google Workspace:
#   host = "smtp.gmail.com"
#   port = 587
# with an app password (not your normal login password).

[smtp]
host = "smtp.office365.com"
port = 587
username = "rma-tool@example.invalid"
password = "REPLACE_ME"
from_address = "rma-tool@example.invalid"
